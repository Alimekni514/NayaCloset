NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
# Leave empty until MongoDB Atlas URI is available
MONGODB_URI=
JWT_ACCESS_SECRET=replace-with-a-64-char-random-secret-generated-by-openssl
JWT_REFRESH_SECRET=replace-with-a-64-char-random-secret-generated-by-openssl
# Cookie settings
# Production (Render): COOKIE_SAME_SITE=none  COOKIE_SECURE=true  COOKIE_DOMAIN=
# Development:         COOKIE_SAME_SITE=lax   COOKIE_SECURE=false COOKIE_DOMAIN=
COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=10
ABM_BASE_URL=https://client.abm-delivery.com
# ⚠️  Real ABM credentials – set in Render env vars, NEVER commit here
ABM_USERNAME=
ABM_PASSWORD=
ABM_REQUEST_TIMEOUT_MS=15000
