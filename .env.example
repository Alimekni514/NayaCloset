NODE_ENV=development
WEB_ORIGIN=http://localhost:5173
API_PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/delivery-commerce
JWT_ACCESS_SECRET=dev-access-secret-32-characters-minimum-0001
JWT_REFRESH_SECRET=dev-refresh-secret-32-characters-minimum-0001
# Cookie settings – override in production (Render env vars)
COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=10
ABM_BASE_URL=https://client.abm-delivery.com
ABM_USERNAME=
ABM_PASSWORD=
ABM_REQUEST_TIMEOUT_MS=15000
